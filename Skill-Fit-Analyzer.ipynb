customer_spends = [120,650,45,890,320,150,710]
total_sales = 0
premium_customer_count = 0
for spend in customer_spends:
    total_sales = total_sales + spend
    if spend > 500:
        premium_customer_count = premium_customer_count + 1
        average_spend = total_sales/ len(customer_spends)
print("---E-COMMERCE CUSTOMER SPENDING REPORT---")
print(f"Total Revenue Generated: ${total_sales}")
print(f"Average Spend per Customer: ${average_spend:.2f}")
print(f"Number of Premium Customers (spent> $500):{premium_customer_count}")
